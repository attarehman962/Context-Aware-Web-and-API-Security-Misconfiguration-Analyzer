# Copy to .env.local for `npm run dev`.

# CAWASMA API as reached from the BROWSER. Inlined into the client bundle at
# build time (`next build`), so changing it needs a rebuild.
NEXT_PUBLIC_API_URL=http://localhost:8000

# CAWASMA API as reached from the Next.js SERVER (server components, route
# handlers). Read at runtime. In docker compose this is http://api:8000.
API_INTERNAL_URL=http://localhost:8000

# true: answer every API call in the browser from MSW fixtures (src/mocks/),
# no backend needed. Inlined at build time like NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_USE_MOCK=false
