# CAWASMA configuration template.
# Copy to `.env` and adjust. NEVER commit the real `.env`.
#
# docker compose reads this file and overrides DATABASE_URL / REDIS_URL /
# CELERY_* with in-network hostnames, so the URLs below are the *host-side*
# values used when running the API, worker, alembic or tests outside Docker.

# --- Environment ---
ENVIRONMENT=development
DEBUG=true

# --- Postgres container credentials (also used to build the in-network URL) ---
POSTGRES_USER=cawasma
POSTGRES_PASSWORD=cawasma
POSTGRES_DB=cawasma

# --- Host ports published by docker compose ---
POSTGRES_HOST_PORT=5446
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# Build the NLP stack (torch/sentence-transformers/spaCy) into the image.
# false = much faster build; the endpoint classifier then runs keyword-only.
INSTALL_ML=true

# --- Datastores (host-side; must match the credentials/ports above) ---
DATABASE_URL=postgresql+asyncpg://cawasma:cawasma@localhost:5446/cawasma
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Frontend / CORS (comma-separated; never "*") ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Scanner safety limits ---
REQUEST_TIMEOUT=15.0
MAX_RESPONSE_SIZE=5000000
MAX_ENDPOINTS=200
MAX_CRAWL_DEPTH=2
MAX_REDIRECTS=5
MAX_CONCURRENT_REQUESTS=10
RATE_LIMIT_PROBE_COUNT=15
USER_AGENT=CAWASMA-Scanner/1.0 (+defensive-security-research)
REQUEST_RETRIES=1
MAX_CRAWL_PAGES=50

# Hostnames allowed to resolve to private ranges. Leave EMPTY here: it is set
# only by docker-compose.eval-scan.yml for the evaluation targets.
# Loopback, link-local and cloud metadata stay blocked regardless.
ALLOWED_INTERNAL_HOSTS=
# Extra CA (PEM) trusted for self-signed demo/eval targets. Leave EMPTY here:
# docker-compose.demo.yml sets it for the demo target only.
SCAN_CA_BUNDLE=

# --- Optional LLM (core scanner works without these) ---
# Used by the NLP classifier to expand URL abbreviations (e.g. usr -> user,
# iam -> identity access management). When LLM_ENABLED=false, or no key is set,
# the built-in abbreviation table is used instead and scanning still works.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_ENABLED=false
LLM_PROVIDER=anthropic
LLM_MODEL=

# Frontend development: contract routes (/api/scan, /api/results, /api/scans)
# return example data from backend/app/api/mock.py. No scans are run.
MOCK_API=false

# Run scans in-process instead of via Celery (no Redis/worker needed).
# Handy for simple deployments and demos. Default: false (uses Celery).
RUN_SCANS_INLINE=false

# Scans per client IP for POST /api/scan ("5/minute", "20/hour"; empty = no limit).
SCAN_RATE_LIMIT=5/minute
# A scan's time budget in seconds; a longer scan ends FAILED ("timed out").
SCAN_TIMEOUT=1200
